{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencraft-skills.vercel.app/schemas/decision-record.schema.json",
  "title": "OpenCraft Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "level", "stage", "status", "question", "why_now", "options", "affected_artifacts", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^DEC-[A-Z0-9]+-[0-9]{3,}$" },
    "level": { "enum": ["D0", "D1", "D2", "D3"] },
    "stage": { "type": "string", "minLength": 1 },
    "status": { "enum": ["example", "pending", "accepted", "rejected", "deferred", "superseded"] },
    "question": { "type": "string", "minLength": 1 },
    "why_now": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "tradeoffs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "tradeoffs": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommendation": { "type": ["string", "null"] },
    "affected_artifacts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "decision": { "type": "string" },
    "decided_by": { "type": "string" },
    "decided_at": { "type": "string", "format": "date-time" },
    "rationale": { "type": "string" },
    "revisit_when": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["accepted", "rejected", "deferred"] } } },
      "then": { "required": ["decided_by", "decided_at", "rationale"] }
    },
    {
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": { "required": ["decision"] }
    }
  ]
}
