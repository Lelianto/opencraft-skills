{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencraft.dev/schema/knowledge/vision/v1",
  "title": "PKD: vision",
  "type": "object",
  "allOf": [
    { "$ref": "#/$defs/envelope" },
    {
      "type": "object",
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "target_users": { "type": "array", "items": { "type": "string" } },
        "primary_journey": { "type": "string" },
        "principles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "statement"],
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string" }
            }
          }
        },
        "success_signals": { "type": "array", "items": { "type": "string" } },
        "non_goals": { "type": "array", "items": { "type": "string" } },
        "domain_terms": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  ],
  "$defs": { "envelope": { "$ref": "https://opencraft.dev/schema/knowledge/envelope/v1" } }
}
