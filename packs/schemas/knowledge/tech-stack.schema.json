{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencraft.dev/schema/knowledge/tech-stack/v1",
  "title": "PKD: tech-stack",
  "type": "object",
  "allOf": [
    { "$ref": "#/$defs/envelope" },
    {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "runtime": { "type": "string" },
        "framework": { "type": "string" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "version": { "type": "string" },
              "alternatives": { "type": "array", "items": { "type": "string" } },
              "rationale": { "type": "string" }
            }
          }
        },
        "pinned_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  ],
  "$defs": { "envelope": { "$ref": "https://opencraft.dev/schema/knowledge/envelope/v1" } }
}
