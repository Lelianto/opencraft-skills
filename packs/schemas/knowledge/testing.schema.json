{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencraft.dev/schema/knowledge/testing/v1",
  "title": "PKD: testing",
  "type": "object",
  "allOf": [
    { "$ref": "#/$defs/envelope" },
    {
      "type": "object",
      "properties": {
        "strategy": { "type": "string" },
        "pyramid": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "requirement"],
            "properties": {
              "name": { "type": "string" },
              "requirement": { "type": "string" }
            }
          }
        },
        "fixtures": { "type": "array", "items": { "type": "string" } }
      }
    }
  ],
  "$defs": { "envelope": { "$ref": "https://opencraft.dev/schema/knowledge/envelope/v1" } }
}
