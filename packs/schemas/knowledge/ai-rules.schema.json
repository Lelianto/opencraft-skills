{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencraft.dev/schema/knowledge/ai-rules/v1",
  "title": "PKD: ai-rules",
  "description": "Structured AI coding rules; the canonical source for .lcdd/ai/AGENTS.md.",
  "type": "object",
  "allOf": [
    { "$ref": "#/$defs/envelope" },
    {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "level", "instruction"],
            "properties": {
              "id": { "type": "string", "pattern": "^ai-.*$" },
              "level": { "type": "string", "enum": ["must", "should", "must-not"] },
              "instruction": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    }
  ],
  "$defs": { "envelope": { "$ref": "https://opencraft.dev/schema/knowledge/envelope/v1" } }
}
