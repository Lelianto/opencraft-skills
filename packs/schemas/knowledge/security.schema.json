{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencraft.dev/schema/knowledge/security/v1",
  "title": "PKD: security",
  "type": "object",
  "allOf": [
    { "$ref": "#/$defs/envelope" },
    {
      "type": "object",
      "properties": {
        "standards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "level": { "type": "string" }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string", "pattern": "^CTRL-.*$" },
              "description": { "type": "string" },
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
              "applies_to": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "sensitive_data": { "type": "array", "items": { "type": "string" } },
        "trust_boundaries": { "type": "array", "items": { "type": "string" } },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    }
  ],
  "$defs": { "envelope": { "$ref": "https://opencraft.dev/schema/knowledge/envelope/v1" } }
}
