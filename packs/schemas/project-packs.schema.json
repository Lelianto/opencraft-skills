{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencraft.dev/schema/project-packs/v1",
  "title": "OpenCraft Project Pack Declaration",
  "description": "The packs.yaml file in a project root declaring which Context Packs apply.",
  "type": "object",
  "required": ["schema", "extends"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://opencraft.dev/schema/project-packs/v1"
    },
    "extends": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-pack(@.+)?$" }
    },
    "conflict_policy": {
      "type": "string",
      "enum": ["fail", "highest-precedence-wins", "keep-first", "human"],
      "default": "fail"
    },
    "overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/override"
      }
    }
  },
  "$defs": {
    "override": {
      "type": "object",
      "required": ["id", "action"],
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string", "enum": ["replace", "patch", "disable", "defer", "resolve"] },
        "pack": { "type": "string" },
        "path": { "type": "string" },
        "patch": { "type": "object" },
        "reason": { "type": "string" }
      }
    }
  }
}
